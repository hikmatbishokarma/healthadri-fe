{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_USE_FIREBASE": "true",
        "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-PROD-API-URL",
        "EXPO_PUBLIC_WEB_URL": "https://healthadri.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
