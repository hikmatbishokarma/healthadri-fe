# Copy to `.env` and fill in. Never commit the real `.env`.
# Anything prefixed EXPO_PUBLIC_ is embedded in the JS bundle and visible to
# anyone with the app — only put non-secret config here (URLs, feature flags).

# Backend API base URL (LAN IP of the dev machine, or your deployed API)
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# Firebase phone auth: true requires a custom native build + google-services.json.
# false uses static OTP 1234 for local testing.
EXPO_PUBLIC_USE_FIREBASE=false

# Public website base URL — the Terms of Use and Privacy Policy pages live here
# (e.g. <base>/terms, <base>/privacy). Set to your deployed domain.
EXPO_PUBLIC_WEB_URL=https://healthadri.com
